<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Game Ular HP</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }
        body {
            background-color: #1a1a1a;
            color: #fff;
            font-family: Arial, sans-serif;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        #header {
            width: 100%;
            max-width: 360px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
        }
        .score-board {
            font-size: 18px;
            font-weight: bold;
        }
        button {
            padding: 8px 16px;
            font-size: 14px;
            font-weight: bold;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        canvas {
            background-color: #000;
            border: 2px solid #4CAF50;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 255, 0, 0.2);
        }
        /* Tombol Kontrol HP */
        #controls {
            margin-top: 15px;
            display: grid;
            grid-template-columns: repeat(3, 65px);
            grid-template-rows: repeat(2, 55px);
            gap: 10px;
            justify-content: center;
        }
        .btn-ctrl {
            background-color: #333;
            color: white;
            font-size: 20px;
            border: 1px solid #555;
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;
            active-background-color: #555;
        }
        .btn-up { grid-column: 2; grid-row: 1; }
        .btn-left { grid-column: 1; grid-row: 2; }
        .btn-down { grid-column: 2; grid-row: 2; }
        .btn-right { grid-column: 3; grid-row: 2; }
    </style>
</head>
<body>

    <div id="header">
        <div class="score-board">Skor: <span id="score">0</span></div>
        <button id="soundToggle" onclick="toggleSound()">🔊 Suara: ON</button>
    </div>

    <!-- Area Layar Game -->
    <canvas id="gameCanvas" width="320" height="320"></canvas>

    <!-- Tombol Kontrol Layar Sentuh -->
    <div id="controls">
        <button class="btn-ctrl btn-up" onclick="changeDirection('UP')">▲</button>
        <button class="btn-ctrl btn-left" onclick="changeDirection('LEFT')">◄</button>
        <button class="btn-ctrl btn-down" onclick="changeDirection('DOWN')">▼</button>
        <button class="btn-ctrl btn-right" onclick="changeDirection('RIGHT')">►</button>
    </div>

    <div style="margin-top: 15px;">
        <button onclick="startGame()">▶ Play / Restart</button>
    </div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");

        const gridSize = 16;
        const tileCount = canvas.width / gridSize;

        let snake = [];
        let food = {};
        let enemy = {};
        let dx = gridSize;
        let dy = 0;
        let score = 0;
        let gameInterval = null;
        let soundEnabled = true;

        // Sound Effects (Web Audio API)
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        function playEatSound() {
            if (!soundEnabled) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = "sine";
            osc.frequency.setValueAtTime(600, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(1000, audioCtx.currentTime + 0.1);
            gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.1);
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById("soundToggle").innerText = soundEnabled ? "🔊 Suara: ON" : "🔇 Suara: OFF";
        }

        function startGame() {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            snake = [
                { x: 5 * gridSize, y: 10 * gridSize },
                { x: 4 * gridSize, y: 10 * gridSize }
            ];
            dx = gridSize;
            dy = 0;
            score = 0;
            document.getElementById("score").innerText = score;

            spawnFood();
            spawnEnemy();

            if (gameInterval) clearInterval(gameInterval);
            gameInterval = setInterval(gameLoop, 150);
        }

        function spawnFood() {
            food = {
                x: Math.floor(Math.random() * tileCount) * gridSize,
                y: Math.floor(Math.random() * tileCount) * gridSize
            };
        }

        function spawnEnemy() {
            enemy = {
                x: Math.floor(Math.random() * tileCount) * gridSize,
                y: Math.floor(Math.random() * tileCount) * gridSize
            };
        }

        function changeDirection(dir) {
            if (dir === 'LEFT' && dx === 0) { dx = -gridSize; dy = 0; }
            if (dir === 'UP' && dy === 0) { dx = 0; dy = -gridSize; }
            if (dir === 'RIGHT' && dx === 0) { dx = gridSize; dy = 0; }
            if (dir === 'DOWN' && dy === 0) { dx = 0; dy = gridSize; }
        }

        function gameLoop() {
            // Gerakkan Ular
            const head = { x: snake[0].x + dx, y: snake[0].y + dy };

            // Menembus tembok (Tempat Luas)
            if (head.x < 0) head.x = canvas.width - gridSize;
            if (head.x >= canvas.width) head.x = 0;
            if (head.y < 0) head.y = canvas.height - gridSize;
            if (head.y >= canvas.height) head.y = 0;

            // Tabrakan dengan tubuh sendiri
            for (let i = 0; i < snake.length; i++) {
                if (head.x === snake[i].x && head.y === snake[i].y) {
                    gameOver();
                    return;
                }
            }

            // Tabrakan dengan Musuh (Tantangan)
            if (head.x === enemy.x && head.y === enemy.y) {
                gameOver();
                return;
            }

            snake.unshift(head);

            // Cek jika makan makanan
            if (head.x === food.x && head.y === food.y) {
                score += 10;
                document.getElementById("score").innerText = score;
                playEatSound();
                spawnFood();
                spawnEnemy(); // Pindahkan musuh setiap makan makanan
            } else {
                snake.pop();
            }

            draw();
        }

        function draw() {
            // Bersihkan Layar
            ctx.fillStyle = "#000";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Gambar Makanan (Merah)
            ctx.fillStyle = "#FF5252";
            ctx.fillRect(food.x, food.y, gridSize - 2, gridSize - 2);

            // Gambar Musuh/Rintangan (Oranye)
            ctx.fillStyle = "#FF9800";
            ctx.fillRect(enemy.x, enemy.y, gridSize - 2, gridSize - 2);

            // Gambar Ular (Hijau)
            for (let i = 0; i < snake.length; i++) {
                ctx.fillStyle = (i === 0) ? "#4CAF50" : "#81C784";
                ctx.fillRect(snake[i].x, snake[i].y, gridSize - 2, gridSize - 2);
            }
        }

        function gameOver() {
            clearInterval(gameInterval);
            alert("Game Over! Skor Anda: " + score);
        }
    </script>
</body>
</html>
